# Copy this file outside git-tracked secrets, for example:
# cp .env.example .env.infra
# SYSTEM2_ENV_FILE=.env.infra uvicorn system2.api:app --reload

# FalkorDB
FALKORDB_HOST=192.168.0.245
FALKORDB_PORT=6379
FALKORDB_PASSWORD=replace-me
FALKORDB_URL=redis://:replace-me@192.168.0.245:6379
FALKORDB_BROWSER_URL=http://192.168.0.245:3000

# Redis
REDIS_HOST=192.168.0.250
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@192.168.0.250:6379/0

# Postgres + pgvector
POSTGRES_HOST=192.168.0.251
POSTGRES_PORT=5432
POSTGRES_DB=graphmem
POSTGRES_USER=graphmem
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://graphmem:replace-me@192.168.0.251:5432/graphmem
PGVECTOR_CONNECTION_STRING=postgresql+psycopg://graphmem:replace-me@192.168.0.251:5432/graphmem

# Backend selection
ADAPTATION_REPOSITORY_BACKEND=postgres
AUDIT_BACKEND=postgres
AGENT_REPOSITORY_BACKEND=postgres
AGENT_STATE_BACKEND=redis
CANDIDATE_POOL_BACKEND=postgres
RETRIEVAL_BACKEND=pgvector
GRAPH_BACKEND=falkordb
SHARED_DATA_BACKEND=postgres

# Frontend/security
# Leave keys unset for local-only development. Set them in shared or deployed
# environments and send either X-API-Key or Authorization: Bearer <key>.
SYSTEM2_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SYSTEM2_API_KEY=replace-me-service-key
SYSTEM2_ADMIN_API_KEY=replace-me-admin-key
